rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Todos os uploads e downloads de arquivos sensíveis passam por Cloud
    // Functions (Admin SDK + URLs assinadas) — o SDK cliente não acessa
    // o Storage diretamente. Bloqueio total no acesso direto.
    // (Fotos de veículos continuam públicas via ACL definida no upload.)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
